# =====================================================================
# Email Automation & Reminder System - Environment Configuration
# =====================================================================
# Copy this file to .env and configure if you wish to test real SMTP sending.
# NOTE: The system runs in safe DRY_RUN mode by default!
# =====================================================================

# 1. Operational Mode (Safety First)
# When True (default), simulates email sending without contacting an SMTP server.
DRY_RUN=True

# Master switch: Actual email sending is completely disabled unless set to True.
ENABLE_ACTUAL_SENDING=False

# 2. Strict Whitelist for Live Test Sends (Comma-separated)
# In live mode, only email addresses listed here will ever be sent emails.
ALLOWED_TEST_RECIPIENTS=tester1@example.com,tester2@example.com

# 3. SMTP Server Configuration (Example for Gmail App Password or Custom SMTP)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_NAME="Automated Reminder System"
SENDER_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# 4. Regional Timezone
APP_TIMEZONE=Asia/Kolkata
